<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
	<test name="Test">
		<classes>
			<class name="org.testing.Base.BaseClass">
			</class>
			<class name="org.testing.TestScripts.GenerateAccessToken">
				<methods>
					<exclude name="generateAccessTokenWithValidCredentials" />
