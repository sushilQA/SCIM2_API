					<exclude name="getSingleUser" />
					<exclude name="getSingleUser_ExpiredOrInvalidAccessToken" />
					<exclude name="getSingleUserNotExist" />
				</methods>

			</class>
			<class name="org.testing.TestScripts.CreateUserSync">
